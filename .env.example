# Copy this file to .env and adjust before running `docker compose up`.
# All values below are the defaults baked into docker-compose.yml.

# Host port the site is published on
APP_PORT=8080

# Database name / application user
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=joomla
JOOMLA_DB_PASSWORD=joomlapass

# MariaDB root password (used only for administration)
DB_ROOT_PASSWORD=rootpass
