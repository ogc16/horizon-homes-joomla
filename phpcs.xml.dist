<?xml version="1.0"?>
<ruleset name="Horizon Homes">
    <description>PSR-12 code style for the com_estate Joomla component.</description>

    <file>components/com_estate</file>
    <exclude-pattern>*/tmpl/*</exclude-pattern>
    <exclude-pattern>*/sql/*</exclude-pattern>

    <rule ref="PSR12"/>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg name="warning-severity" value="0"/>
    <arg value="p"/>

    <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
